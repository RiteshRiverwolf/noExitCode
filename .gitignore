# Python (.venv-ocr holds PaddleOCR, kept apart from the workbench's dependencies)
.venv/
.venv-ocr/
__pycache__/
*.pyc

# Generated corpus -- reproducible from a seed:
#   python bench/make_corpus.py --count 12 --out data/corpus
data/corpus/

# External source documents stay out of version control.
# The MRPL tender contains real employees' names, phone numbers and emails,
# and several other sources restrict redistribution. See docs/DATASETS.md
# for where to download each one.
data/external/

# Stage 0 runtime state -- AnythingLLM storage (database, vectors, uploaded
# documents, local .env) and documents generated by the test tool.
stage0/anythingllm/
stage0/output/

# Full packet captures record the test harness's plain-HTTP requests,
# including the AnythingLLM API key. Only the dropped-packet captures (the
# evidence of blocked outbound attempts) are committed.
results/stage0/pcap*/*.pcap
!results/stage0/pcap*/*_dropped.pcap

# Runtime logs of our MCP servers (tool-call audit logs, the approval-page
# URL with its secret token).
logs/

# Per-job run folders written by the workbench (evidence, decisions, notes).
runs/

# Model weights served by llama-server outside Ollama (GGUF files, tens of GB).
models/

# Working output of the stage 1 test scripts (kept results live in results/stage1/data/).
bench/stage1/extract_results/
bench/stage1/writer_results/
bench/stage1/occlusion/
bench/stage1/partial/
bench/stage1/ppstructure/
bench/stage1/paddle_results/
bench/stage1/*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
